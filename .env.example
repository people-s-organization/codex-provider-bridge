# Optional: if you already have a valid ChatGPT Web access token, put it here.
CHATGPT_ACCESS_TOKEN=

# Optional: required for /v1/audio/speech and as an image fallback.
# /v1/images/generations prefers the ChatGPT/Codex image_generation tool when
# CHATGPT_ACCESS_TOKEN is available.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
CHATGPT_ACCOUNT_ID=

# Auth preference:
# - auto: if token sources 1/2 are missing and the terminal is interactive,
#         ask you to choose browser login or device-code at startup
# - browser: always try browser login first
# - device: always use device-code
# - prompt: always ask which login flow to use
# Note: CLI --auth takes precedence over this env var.
CHATGPT_AUTH_METHOD=prompt

# Server bind configuration
HOST=127.0.0.1
PORT=8000
# Set before exposing the bridge beyond loopback. Never log this value.
BRIDGE_API_KEY=
ALLOW_UNAUTHENTICATED_PUBLIC=false
MAX_REQUEST_BYTES=16777216
MAX_CONCURRENT_REQUESTS=32
# Reject ignored API options instead of accepting with X-Bridge-Warnings.
BRIDGE_STRICT_COMPATIBILITY=false
# Bridge-owned Responses storage backing store/previous_response_id.
BRIDGE_RESPONSE_STORE_MAX=256
BRIDGE_RESPONSE_STORE_TTL=3600
# Browser clients: comma-separated origins, or * for any (credentials then disabled).
BRIDGE_CORS_ORIGINS=*
# Emit an SSE ": ping" comment after this many idle seconds; 0 disables.
STREAM_KEEPALIVE_SECONDS=15
# Upstream generation POSTs are never automatically retried.
UPSTREAM_CONNECT_TIMEOUT=15
UPSTREAM_FIRST_EVENT_TIMEOUT=120
UPSTREAM_IDLE_TIMEOUT=120
UPSTREAM_WRITE_TIMEOUT=30
UPSTREAM_POOL_TIMEOUT=15
UPSTREAM_MAX_CONNECTIONS=32
UPSTREAM_MAX_EVENT_BYTES=16777216

# Optional upstream override
CHATGPT_BASE_URL=https://chatgpt.com

# Optional model registry override. Nothing is hard-coded: when CHATGPT_MODELS is empty
# the bridge uses ~/.codex/models_cache.json, and if that has no models it asks the
# Codex backend once. With no real source the model list stays empty.
# Examples:
# CHATGPT_MODELS=<model-id>,<model-id>
# CHATGPT_EXTRA_MODELS=<model-id>
# CHATGPT_DEFAULT_MODEL=<model-id>
# CHATGPT_MEDIA_MODEL=<responses-model-id>   # Responses model used for image generation
# CHATGPT_REALTIME_MODEL=<realtime-model-id> # realtime model used for speech
CHATGPT_MODELS=
CHATGPT_EXTRA_MODELS=
CHATGPT_DEFAULT_MODEL=
CHATGPT_MEDIA_MODEL=
CHATGPT_REALTIME_MODEL=
CHATGPT_MODELS_FILE=~/.codex/models_cache.json
CHATGPT_CODEX_CONFIG_FILE=~/.codex/config.toml
# Upstream model listing URL. Defaults to $CHATGPT_BASE_URL/backend-api/codex/models;
# set it to an empty value to disable the upstream lookup entirely.
# CHATGPT_MODELS_URL=
# Optional installed client version override, required by upstream discovery.
# Otherwise read from the real cache or installed `codex --version`.
# CHATGPT_CLIENT_VERSION=
# Capability listing URL (ChatGPT web model list, which flags the image tool).
# Defaults to $CHATGPT_BASE_URL/backend-api/models; empty value disables it.
# CHATGPT_CAPABILITIES_URL=

# Optional aliases for client compatibility. Nothing is aliased by default.
# JSON object or comma-separated pairs are supported.
# Examples:
# CHATGPT_MODEL_ALIASES={"gpt-4.1":"<model-id>","gpt-4.1-mini":"<model-id>"}
# CHATGPT_EXTRA_MODEL_ALIASES=gpt-old=<model-id>
CHATGPT_MODEL_ALIASES=
CHATGPT_EXTRA_MODEL_ALIASES=
